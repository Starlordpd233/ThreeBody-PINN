  "plain_language": "Before the first real experiment the project writes down exactly how every experiment will run and fingerprints the code that will run it. Each experiment then refuses to start if anything changed, if its data file is missing, or if the earlier results say it should not run.",
  "polish": {
    "adam_wall": "Adam's running time is the whole Adam phase (steps plus scoring readings) summed across segments, without interruptions. The polish cap is 25% of it.",
    "applies_to": "every_single_system_arm",
    "e_never_steers": "The scored position error E may be logged at each outer call for the trace, but it never steers the polish.",
    "full_batch": true,
    "improvement": "After each outer call its full-batch objective is compared with the best so far: a strictly lower value resets the count of calls without improvement, otherwise the count goes up. The starting value is the objective at the Adam result. Then polish_should_stop is called.",
    "lbfgs_history_size": 10,
    "lbfgs_line_search": "strong_wolfe",
    "lbfgs_max_iter": 50,
    "non_finite": "If an outer call returns a non-finite objective or leaves non-finite parameters, the polish stops and the polish state is the parameters from before that call.",
