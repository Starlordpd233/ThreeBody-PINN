{
  "amendment_commit": "dc3edac0e9ae737b42be276dd9b67e12b8ab8926",
  "approved_omega_rule": {
    "rule": "A continue-path arm may run at any finite positive first_omega_0 that the committed checkpoint 4 ruling names, on or off the sweep grid. D-07 runs at that value. Every continue-path record cites the ruling file's SHA-256 and states on_grid and equals_confirmed. A physics arm refuses any other value.",
    "ruling_file": ".planning/phases/60-single-system-learnability/60-CHECKPOINT-4-RULING.md",
    "source": "GAP-60-11 and D-11"
  },
  "budget": {
    "after_extension": "inconclusive_with_rate",
    "cap_hours_rung3": 8.0,
    "cap_hours_single_system": 3.0,
    "control_adam_steps": 1000,
    "extension_factor": 2.0,
    "extensions_max": 1,
    "scoring_cadence_max_fraction": 0.05,
    "seconds_per_step": "timing_run_wall_seconds_over_steps",
    "still_improving_final_fraction": 0.25,
    "still_improving_min_relative_drop": 0.1,
    "still_improving_reference_fraction": 0.75,
    "still_improving_statistic": "best_E",
    "timing_run_min_steps": 50
  },
  "cadence": {
    "max_fraction": 0.05,
    "rule": "The scorer is read at step 0, every floor(0.05 B) steps and at B, and on to 2B after the one extension, so that no gap is larger than 5% of the step budget. A physics arm logs the frozen monitor's per-bin causal weights and front at these readings and never halts on them (D-06).",
    "source": "D-06 and the frozen budget rule"
  },
