#!/usr/bin/env bash
# wd-arm — consumer-side watcher for the cross-session watchdog (P1, MVP).
#
# This is the P1 "background-watcher" wake path and the ONLY path the MVP ships.
# Agent B runs this in the background from inside its own Claude Code session;
# when the watcher exits, the harness re-enters B's conversation, so the wake
# targets the right session by construction. The watcher polls wd-check and, on
# the first WAKE, performs an atomic exactly-once claim and exits.
#
# This script installs ONLY the background watcher. It does NOT register a cron
# (no CronCreate). The durable P2 cron path is out of scope here and is gated on
# the Phase 4 termination-guarantee contract; see the implementation plan.
#
# Exactly-once claim: the claim is an atomic `mkdir <channel>/claimed.<head>`.
# mkdir is atomic on POSIX filesystems, so exactly one watcher (across any wake
# path) creates the directory and prints WAKE; every other watcher on the same
# head prints ALREADY-CLAIMED. This is the shared guard against double-starts.
#
# Dead-producer guard: with --timeout-secs N (>0), if no WAKE is seen within N
# seconds the watcher prints PRODUCER-STALLED and exits 42, so an unattended B
# never waits forever on a producer that died.
#
# Task payload (F9): the task B should perform on wake is persisted at ARM time
# to <channel>/consumer-task.md (via --task-file), so a woken B knows what to do
# even after a restart. The wake prompt is a FIXED CONSTANT that points B at that
# file by name; channel-file contents are NEVER interpolated into the prompt.
# A missing --task-file is non-fatal: the watcher warns and arms without a
# payload, so a bad path can never silently prevent the watcher from arming.
#
#   Fixed wake prompt (the arming session fires this verbatim on re-entry):
#     "Watchdog: read `consumer-task.md` in this channel and the `wd-arm` result
#      line; if WAKE, begin that task; if ALREADY-CLAIMED or PRODUCER-STALLED,
#      stop and report."
#
# Cross-worktree wake sequence: when A and B are in DIFFERENT worktrees, B's
# branch does not yet contain A's done commit, so after this watcher prints WAKE,
# B integrates A's commit before acting:
#   wd-arm (WAKE)  ->  wd-integrate  ->  wd-check --require-integration (WAKE)  ->  begin
# Same-worktree (the common case) skips wd-integrate entirely — A's done commit
# is already on B's HEAD and A's files are already in B's checkout.
#
# Output / exit:
#   WAKE <head>             exit 0   claimed; begin the consumer-task.md task
#   ALREADY-CLAIMED <head>  exit 0   another watcher already claimed this head
#   PRODUCER-STALLED after Ns  exit 42   timed out with no done marker
#   DISARMED                exit 0   stood down via the <channel>/disarm sentinel
#
# Termination guarantee (Phase 4): every armed watcher records its existence in
# <channel>/armed.json (single-line JSON) so wd-disarm/wd-status — and a future
# P2 durable-cron armer — can see it. The watcher removes its own record on every
# exit path. The <channel>/disarm sentinel is the fast-path standdown signal: an
# in-flight watcher checks it on every poll and exits DISARMED on the next tick.
# This on-disk lifecycle is the shared substrate for both P1 and P2; the harness
# CronCreate (agent-side) is NOT involved here.
#
# Usage: wd-arm (--channel NAME | --phase NN | --key STR) [--poll-secs N] [--timeout-secs N] [--task-file PATH]
set -uo pipefail
source "$(dirname "$0")/lib/wd-common.sh"
# wd-common.sh sets `set -e`; restore this script's declared options so the
# long-running watch loop is not killed by an expected non-zero from wd-check.
set +e

channel=
phase=
key=
poll=20
timeout=0
task_file=
while [ $# -gt 0 ]; do
  case "$1" in
    --channel) channel=$2; shift 2 ;;
    --phase) phase=$2; shift 2 ;;
    --key) key=$2; shift 2 ;;
    --poll-secs) poll=$2; shift 2 ;;
    --timeout-secs) timeout=$2; shift 2 ;;
    --task-file) task_file=$2; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
channel="$(wd_resolve_channel "${0##*/}" "$channel" "$phase" "$key")" || exit 2

dir="$(wd_channel_dir "$channel")"
here="$(dirname "$0")"
start="$(date +%s)"

# Remove this watcher's armed.json record. Idempotent (`rm -f`) so wd-disarm
# having removed it first is not fatal under the loop's set +e semantics, and
# silent (`2>/dev/null || true`) so it never masks the intended exit code.
remove_armed_record() { rm -f "$dir/armed.json" 2>/dev/null || true; }

# Disarm-standdown: drop the armed record + sentinel and print DISARMED. Used by
# BOTH the in-loop sentinel check (Deliverable 1.2) and the TERM trap. The trap
# is the backstop for wd-disarm's best-effort `kill`: if SIGTERM lands during the
# poll loop's sleep, the watcher still exits 0 with DISARMED instead of being
# killed silently. Normal WAKE / ALREADY-CLAIMED / PRODUCER-STALLED exits do not
# raise SIGTERM, so the trap never masks their exit codes.
disarm_standdown() {
  remove_armed_record
  rm -f "$dir/disarm" 2>/dev/null || true
  echo "DISARMED"
  exit 0
}
trap disarm_standdown TERM

# Persist the task payload at arm time so a woken (or restarted) B knows what to
# do. Written atomically; the wake prompt references this file, never its bytes.
if [ -n "$task_file" ]; then
  if [ -f "$task_file" ]; then
    mkdir -p "$dir"
    tmp="$dir/.consumer-task.md.tmp.$$"
    cat "$task_file" > "$tmp"
    mv "$tmp" "$dir/consumer-task.md"
  else
    # A bad path must not silently kill the arm: warn and arm without a payload.
    echo "wd-arm: --task-file not found: $task_file (arming without a task payload)" >&2
  fi
fi

# Record this watcher on disk so wd-disarm/wd-status can see it. Schema matches
# the Phase 4 brief verbatim. ttl is --timeout-secs (the watcher's own TTL bound)
# or null when --timeout-secs is 0 (no self-termination). Written atomically so a
# concurrent reader never sees a half-written file.
mkdir -p "$dir"
armed_by="${GIT_AGENT_ID:-}"
[ -n "$armed_by" ] || armed_by="unknown"
if [ "$timeout" -gt 0 ]; then ttl_json="$timeout"; else ttl_json="null"; fi
armed_tmp="$dir/.armed.json.tmp.$$"
printf '{"kind":"watcher","channel":"%s","armed_at":%s,"ttl":%s,"armed_by":"%s","pid":%s}\n' \
  "$channel" "$start" "$ttl_json" "$armed_by" "$$" > "$armed_tmp"
mv "$armed_tmp" "$dir/armed.json"

while true; do
  st="$("$here/wd-check" --channel "$channel" || true)"
  if [ "${st%%:*}" = WAKE ]; then
    head="$(sed -n 's/.*"head":"\([^"]*\)".*/\1/p' "$dir/done.json" | head -1)"
    if mkdir "$dir/claimed.$head" 2>/dev/null; then
      remove_armed_record
      echo "WAKE $head"
    else
      remove_armed_record
      echo "ALREADY-CLAIMED $head"
    fi
    exit 0
  fi
  if [ "$timeout" -gt 0 ] && [ "$(( $(date +%s) - start ))" -ge "$timeout" ]; then
    remove_armed_record
    echo "PRODUCER-STALLED after ${timeout}s"
    exit 42
  fi
  # Disarm-sentinel fast-path standdown: a finished handoff (or wd-disarm) drops
  # a <channel>/disarm file to tell an in-flight watcher to quit on its very next
  # poll. The watcher consumes the sentinel and its armed record on the way out.
  if [ -e "$dir/disarm" ]; then
    remove_armed_record
    rm -f "$dir/disarm" 2>/dev/null || true
    echo "DISARMED"
    exit 0
  fi
  sleep "$poll"
done
